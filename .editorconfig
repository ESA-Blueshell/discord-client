root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 4

[*.{json,yml,yaml,md,ts,mjs}]
indent_size = 2

# Generated. Never reformat by hand; it is overwritten on every spec sync.
[specs/*.json]
insert_final_newline = true
trim_trailing_whitespace = false

[typescript/src/generated/**]
trim_trailing_whitespace = false

[gradlew.bat]
end_of_line = crlf
