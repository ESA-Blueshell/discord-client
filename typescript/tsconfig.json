{
  "compilerOptions": {
    "target": "ES2023",
    // DOM is required, not cosmetic: the generated axios client references
    // BodyInit/Blob. The package targets browsers (the website frontend) as
    // well as Node, so the DOM lib is the honest declaration of that.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "openapi-ts.config.ts", "vitest.config.ts"]
}
