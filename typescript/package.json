{
  "name": "@esa-blueshell/discord-client",
  "version": "0.2.1",
  "description": "TypeScript client for the subset of the Discord HTTP API declared in specs/surface.json. Generated with @hey-api/openapi-ts; do not edit src/generated by hand.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ESA-Blueshell/discord-client.git"
  },
  "homepage": "https://github.com/ESA-Blueshell/discord-client#readme",
  "bugs": {
    "url": "https://github.com/ESA-Blueshell/discord-client/issues"
  },
  "keywords": [
    "discord",
    "openapi",
    "client",
    "generated",
    "hey-api"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test --max-warnings 0"
  },
  "peerDependencies": {
    "axios": ">=1.18.0 <2"
  },
  "dependencies": {
    "@hey-api/client-axios": "0.9.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "24.9.2",
    "axios": "1.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  }
}
